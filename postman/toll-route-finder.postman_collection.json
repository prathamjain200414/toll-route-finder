{
  "info": {
    "_postman_id": "ac49258b-c1bb-4a41-9096-9910be8de3a6",
    "name": "Toll Route Finder",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Toll plazas between two Indian pincodes. Set `baseUrl` to http://localhost:8080 to run locally. The hosted server sleeps when idle: run \"Wake the server\" first (it can take ~2 minutes)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://toll-route-finder.onrender.com"
    }
  ],
  "item": [
    {
      "name": "0. Wake the server (health)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Toll plazas (required API)",
      "item": [
        {
          "name": "Bengaluru 560064 -> Pune 411045 (Mappls test case)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/toll-plazas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "toll-plazas"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourcePincode\": \"560064\",\n  \"destinationPincode\": \"411045\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response has the specified shape\", () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.route).to.have.all.keys(\"sourcePincode\", \"destinationPincode\", \"distanceInKm\");",
                  "  j.tollPlazas.forEach(t => pm.expect(t).to.have.all.keys(\"name\", \"latitude\", \"longitude\", \"distanceFromSource\"));",
                  "});",
                  "pm.test(\"Plazas are ordered by distance from source\", () => {",
                  "  const d = pm.response.json().tollPlazas.map(t => t.distanceFromSource);",
                  "  pm.expect(d).to.eql([...d].sort((a, b) => a - b));",
                  "});",
                  "pm.test(\"Finds the 12 plazas on the route\", () => pm.expect(pm.response.json().tollPlazas.length).to.eql(12));",
                  "pm.test(\"Road distance ~854 km\", () => pm.expect(pm.response.json().route.distanceInKm).to.be.within(840, 870));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same request again -> served from cache",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/toll-plazas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "toll-plazas"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourcePincode\": \"560064\",\n  \"destinationPincode\": \"411045\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"X-Cache is HIT\", () => pm.response.to.have.header(\"X-Cache\", \"HIT\"));"
                ]
              }
            }
          ]
        },
